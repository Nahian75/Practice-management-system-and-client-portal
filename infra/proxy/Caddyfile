# Stass Practice Management System — Production Caddy Configuration
# Enforces Review F2, W1, W3, D2 specifications:
# 1. Routes /api/ directly to NestJS (127.0.0.1:3001) bypassing Next.js middleware
# 2. Strict upload body limits: 52 MB on multipart uploads, 1 MB default
# 3. Preserves Host and forwards client IP in X-Forwarded-For
# 4. Automated HTTPS with TLS 1.3 / 1.2

{
    admin off
    auto_https disable_redirects
    servers {
        trusted_proxies static private_ranges
        client_ip_headers X-Forwarded-For X-Real-IP
    }
}

# Replace :443 with domain or configure per environment
:443 {
    tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem {
        protocols tls1.2 tls1.3
    }

    # Security Headers
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # 1. Large Upload Routes (52 MB Limit)
    # - /api/matters/*/documents
    # - /api/documents/*/versions
    # - /api/clients/*/cdd/*/evidence
    # - /api/compliance/restricted-reports
    # - /api/hr/people/*/files
    @multipart_uploads {
        path_regexp upload ^/api/(matters/[^/]+/documents|documents/[^/]+/versions|clients/[^/]+/cdd/[^/]+/evidence|compliance/restricted-reports|hr/people/[^/]+/files)$
    }
    handle @multipart_uploads {
        request_body {
            max_size 52MB
        }
        uri strip_prefix /api
        reverse_proxy 127.0.0.1:3001 {
            header_up Host {host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
            transport http {
                response_header_timeout 120s
            }
        }
    }

    # 2. Authentication Sign-In Endpoint (64 KB Limit)
    @auth_sign_in path /api/auth/sign-in
    handle @auth_sign_in {
        request_body {
            max_size 64KB
        }
        uri strip_prefix /api
        reverse_proxy 127.0.0.1:3001 {
            header_up Host {host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
        }
    }

    # 3. All Other API Endpoints (1 MB Limit)
    @api_general path /api/*
    handle @api_general {
        request_body {
            max_size 1MB
        }
        uri strip_prefix /api
        reverse_proxy 127.0.0.1:3001 {
            header_up Host {host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
        }
    }

    # 4. Web Application Frontend (1 MB Limit)
    handle {
        request_body {
            max_size 1MB
        }
        reverse_proxy 127.0.0.1:3000 {
            header_up Host {host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
        }
    }
}
