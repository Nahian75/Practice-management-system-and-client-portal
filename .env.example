# Local development only. Copy to .env and replace every value.
# Generate a password with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=
PMS_OWNER_PASSWORD=
PMS_APP_PASSWORD=
# Document storage (SeaweedFS); the API is given the same pair.
DOCUMENTS_S3_ACCESS_KEY=
DOCUMENTS_S3_SECRET_KEY=
