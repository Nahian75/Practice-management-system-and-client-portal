{
  "name": "@practice/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "start:local": "node --env-file=.env --enable-source-maps dist/main.js",
    "migrate": "node --enable-source-maps dist/database/migrate.js",
    "migrate:local": "node --env-file=.env --enable-source-maps dist/database/migrate.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "kysely": "0.29.6",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
