{
  "name": "@practice/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "start:local": "node --env-file=.env --enable-source-maps dist/main.js",
    "migrate": "node --enable-source-maps dist/database/migrate.js",
    "migrate:local": "node --env-file=.env --enable-source-maps dist/database/migrate.js",
    "invite": "node --enable-source-maps dist/cli/invite.js",
    "invite:local": "node --env-file=.env --enable-source-maps dist/cli/invite.js",
    "retention:sweep": "node --enable-source-maps dist/cli/retention-sweep.js",
    "retention:sweep:local": "node --env-file=.env --enable-source-maps dist/cli/retention-sweep.js",
    "audit:verify": "node --enable-source-maps dist/cli/audit-verify.js",
    "audit:verify:local": "node --env-file=.env --enable-source-maps dist/cli/audit-verify.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@aws-sdk/lib-storage": "3.1141.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "busboy": "1.6.0",
    "kysely": "0.29.6",
    "nodemailer": "10.3.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@types/busboy": "1.5.4",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
