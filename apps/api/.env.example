# Copy to .env for local development. Never put real credentials here.
NODE_ENV=development
# The API is reached only through the web app (apps/web), which owns the public
# address; the API listens on a private port.
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=log

# The API connects as pms_app. Migrations connect as pms_owner.
# In production both must end with ?sslmode=verify-full
DATABASE_URL=postgres://pms_app:<password>@127.0.0.1:5432/pms
MIGRATION_DATABASE_URL=postgres://pms_owner:<password>@127.0.0.1:5432/pms

# 32 random bytes, base64. Encrypts 2FA secrets. Losing it means every account must re-enrol 2FA.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=

# The web app's public address: links in emails point here. Must be https in production.
APP_BASE_URL=http://localhost:3000
# Local: Mailpit (docker compose). Production: the provider's smtps:// or smtp:// (STARTTLS is then required).
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM_ADDRESS=no-reply@practice.test
MAIL_FROM_NAME=Practice Portal
# A separate 32-byte base64 key for queued addresses, subjects and bodies.
# Generate it as for TOTP_ENCRYPTION_KEY and keep it outside PostgreSQL.
MAIL_ENCRYPTION_KEY=

# A separate 32-byte base64 key for bank details. Losing it makes those details unreadable.
# Generate it as for TOTP_ENCRYPTION_KEY and keep it outside PostgreSQL.
FINANCE_ENCRYPTION_KEY=

# A separate 32-byte base64 key for AML identity data and protected evidence.
# Losing it makes protected compliance records and evidence unreadable.
AML_ENCRYPTION_KEY=

# Proxies whose X-Forwarded-For is believed. Every request arrives through the web
# app, so locally that is loopback; in production, the web app's address (and the
# load balancer's range in front of it), nothing wider.
TRUSTED_PROXIES=loopback

# Document storage: SeaweedFS from docker compose. The key pair is the one in the
# repository root .env (DOCUMENTS_S3_ACCESS_KEY / DOCUMENTS_S3_SECRET_KEY).
# In production the endpoint must be https.
DOCUMENTS_S3_ENDPOINT=http://127.0.0.1:8333
DOCUMENTS_S3_BUCKET=pms-documents
DOCUMENTS_S3_ACCESS_KEY=
DOCUMENTS_S3_SECRET_KEY=
# 32 random bytes, base64. Seals each document's own key. Losing it makes every stored document unreadable.
DOCUMENT_ENCRYPTION_KEY=
# ClamAV from docker compose. It has no authentication: keep it on a private network.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Integration tests use a separate database.
TEST_DATABASE_URL=postgres://pms_app:<password>@127.0.0.1:5432/pms_test
TEST_MIGRATION_DATABASE_URL=postgres://pms_owner:<password>@127.0.0.1:5432/pms_test
# Mailpit API, read by tests to check sent emails.
TEST_MAILPIT_URL=http://127.0.0.1:8025
