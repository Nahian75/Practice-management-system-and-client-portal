# Secrets and environment files
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# Dependencies
node_modules/
.venv/
__pycache__/

# Build output
dist/
build/
.next/
out/
coverage/
next-env.d.ts
*.tsbuildinfo

# Browser test output: screenshots and traces can show synthetic data and tokens
test-results/
playwright-report/

# Local data — never commit uploads, dumps or databases
uploads/
storage/
*.sql.gz
*.dump
*.sqlite
*.db

# Logs
*.log
logs/

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Local demo login details: this computer only, never committed.
DEMO-LOGIN.txt

# Generated local presentations and screenshots can contain account details.
/docs/*.html
/docs/*.pdf
/docs/*.zip
/docs/*.tar.gz
/docs/ui-design-assets/
/docs/manage-ui-assets/
